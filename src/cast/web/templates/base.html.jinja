<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}cast{% endblock %}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<style>
  :root {
    --bg: #f5f6f8; --panel: #ffffff; --panel-2: #f0f2f5; --line: #e3e6ea;
    --text: #1a1d23; --muted: #6b7280; --accent: #2563eb; --accent-soft: #e6eefe;
    --ok: #15803d; --ok-soft: #e3f4e8;
    --crit: #b42318; --crit-soft: #fde4e1; --high: #b45309; --high-soft: #fdebd8;
    --med: #8a6a00; --med-soft: #fbf1cc; --low: #4b5563; --low-soft: #eceef1;
    --info: #0b5d83; --info-soft: #dff0f9;
    --folder: #4c9df0; --file: #c3c8d0;
    --code: #f3f4f6; --shadow: 0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.04);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115; --panel: #171a21; --panel-2: #1d212a; --line: #2a2f3a;
      --text: #e6e8ec; --muted: #9aa3b2; --accent: #6b9bff; --accent-soft: #1d2a45;
      --ok: #4ade80; --ok-soft: #12291b;
      --crit: #ff7b72; --crit-soft: #3a1714; --high: #f5a35c; --high-soft: #35220f;
      --med: #e8c55a; --med-soft: #30280c; --low: #b3bac6; --low-soft: #252a33;
      --info: #67c1ec; --info-soft: #11283a;
      --folder: #6cb6ff; --file: #d5d9e0;
      --code: #11141a; --shadow: none;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  code, .mono { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .86em; }
  header.top { display: flex; align-items: center; gap: 1rem; padding: .8rem 1.5rem;
               background: var(--panel); border-bottom: 1px solid var(--line); }
  header.top .logo { font-weight: 800; font-size: 1.15rem; letter-spacing: .02em; color: var(--text); }
  header.top .logo span { color: var(--accent); }
  header.top .ver { color: var(--muted); font-size: .8rem; }
  header.top nav { margin-left: auto; display: flex; gap: 1rem; }
  main { max-width: 1900px; margin: 0 auto; padding: 1.2rem 1.5rem; }
  main.narrow { max-width: 1180px; }
  h1 { font-size: 1.45rem; margin: 0 0 .3rem; }
  h2 { font-size: 1.12rem; margin: 0; }
  .muted { color: var(--muted); }
  .small { font-size: .84rem; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
          padding: 1.1rem 1.25rem; box-shadow: var(--shadow); margin-bottom: 1rem; }
  .grid { display: grid; gap: 1rem; }
  .cols-2 { grid-template-columns: 2fr 1fr; }
  @media (max-width: 900px) { .cols-2 { grid-template-columns: 1fr; } }
  .btn { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid var(--line);
         background: var(--panel); color: var(--text); border-radius: 8px; padding: .45rem .85rem;
         font: inherit; font-size: .9rem; cursor: pointer; }
  .btn:hover { background: var(--panel-2); text-decoration: none; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  .btn.primary:hover { filter: brightness(1.08); }
  input[type=text] { width: 100%; font: inherit; color: var(--text); background: var(--panel-2);
         border: 1px solid var(--line); border-radius: 8px; padding: .6rem .8rem; }
  input[type=password] { width: 100%; font: inherit; color: var(--text); background: var(--panel-2);
                         border: 1px solid var(--line); border-radius: 8px; padding: .6rem .8rem; }
  input[type=password]:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .login { max-width: 380px; margin: 3rem auto; }
  .login form { display: flex; flex-direction: column; gap: .8rem; }
  .login .btn { justify-content: center; }
  .login label { display: flex; flex-direction: column; gap: .25rem; font-weight: 600; font-size: .9rem; }
  .login-error { color: var(--crit); background: var(--crit-soft); border-radius: 6px; padding: .4rem .6rem; }
  input[type=text]:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .chip { display: inline-flex; align-items: center; gap: .35rem; border: 1px solid var(--line);
          background: var(--panel-2); border-radius: 999px; padding: .2rem .65rem; font-size: .82rem;
          cursor: pointer; color: var(--text); user-select: none; }
  .chip:hover { border-color: var(--accent); }
  .chip.off { opacity: .4; }
  .pill { display: inline-block; border-radius: 6px; padding: .08rem .45rem; font-size: .74rem;
          font-weight: 700; letter-spacing: .02em; white-space: nowrap; }
  .sev-critical, .st-WARN { background: var(--crit-soft); color: var(--crit); }
  .sev-high { background: var(--high-soft); color: var(--high); }
  .sev-medium, .st-NOTE { background: var(--med-soft); color: var(--med); }
  .sev-low, .sev-unknown { background: var(--low-soft); color: var(--low); }
  .st-INFO { background: var(--info-soft); color: var(--info); }
  .st-PASS, .ok-soft { background: var(--ok-soft); color: var(--ok); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: .55rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top;
           overflow-wrap: anywhere; }
  th { overflow-wrap: normal; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; }
  tr:last-child td { border-bottom: none; }
  .table-wrap { overflow-x: visible; }
  table.fixed { table-layout: fixed; }
  .fix { color: var(--ok); font-size: .86rem; margin-top: .25rem; }
  .sub-line { color: var(--muted); font-size: .82rem; margin-top: .2rem; }
  details > summary { cursor: pointer; color: var(--muted); font-size: .84rem; }
  pre.code { background: var(--code); border: 1px solid var(--line); border-radius: 8px; padding: .5rem .7rem;
             margin: .35rem 0 0; overflow-x: auto; font-size: .8rem; line-height: 1.45; }
  pre.code .cause { background: var(--crit-soft); display: block; }
  .banner { border-radius: 10px; padding: .8rem 1rem; margin-bottom: 1rem; font-weight: 600; }
  .banner.bad { background: var(--crit-soft); color: var(--crit); }
  .banner.note { background: var(--med-soft); color: var(--med); font-weight: 400; white-space: pre-wrap; }
  .row { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .spacer { flex: 1; }
  .dot { width: .55rem; height: .55rem; border-radius: 50%; display: inline-block; }
  .dot.on { background: var(--ok); } .dot.off { background: var(--crit); }
  .dot.run { background: var(--accent); animation: pulse 1s infinite alternate; }
  @keyframes pulse { from { opacity: .3; } to { opacity: 1; } }
  .bar { height: 8px; background: var(--panel-2); border-radius: 999px; overflow: hidden; }
  .bar > div { height: 100%; background: var(--accent); width: 0; transition: width .3s; }
  .bar.indet > div { width: 30%; animation: slide 1.2s infinite ease-in-out; }
  @keyframes slide { from { margin-left: -30%; } to { margin-left: 100%; } }
  .log { background: var(--code); border-radius: 8px; padding: .6rem .8rem; max-height: 260px; overflow-y: auto;
         font-size: .8rem; margin-top: .8rem; }
  .jobs a { display: flex; gap: .6rem; align-items: center; padding: .45rem 0; border-bottom: 1px solid var(--line);
            color: var(--text); }
  .jobs a:last-child { border-bottom: none; }
  .jobs a:hover { text-decoration: none; color: var(--accent); }
  .section-head { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; margin-bottom: .7rem; }
  .group-title { font-weight: 700; margin: 1.1rem 0 .3rem; display: flex; gap: .6rem; align-items: baseline; }
  .group-title .muted { font-weight: 400; font-size: .84rem; }
  ul.details { margin: .3rem 0 0; padding-left: 1.1rem; color: var(--muted); font-size: .84rem; }
  tr.is-pass td { color: var(--muted); }
  .hidden { display: none !important; }
  .nowrap { white-space: nowrap; }
  .btn:disabled { opacity: .45; cursor: not-allowed; filter: none; }
  .small-btn { padding: .25rem .6rem; font-size: .82rem; }
  /* ошибки конфигурации: место в файле, код как в терминале, правила */
  .place { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .8rem; }
  .place-head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; font-weight: 700; color: var(--info); }
  pre.term { background: #0d1117; color: #e6edf3; border-radius: 8px; padding: .6rem .8rem; margin: .5rem 0;
             font: .82rem/1.45 "JetBrains Mono", ui-monospace, Menlo, monospace;
             white-space: pre-wrap; overflow-wrap: anywhere; }
  pre.term .ln, pre.term .dimmed { color: #7d8590; }
  pre.term .mk { color: #e3b341; }
  pre.hint { background: transparent; margin: .35rem 0 0; padding: 0;
             font: .8rem/1.45 "JetBrains Mono", ui-monospace, Menlo, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
  pre.hint .h-exists { color: var(--muted); } pre.hint .h-new { color: var(--ok); } pre.hint .h-old { color: var(--med); }
  /* главная: проводник слева, что проверить в центре, проверки и движки справа */
  .layout { display: grid; gap: 1rem; align-items: start;
            grid-template-columns: minmax(460px, 34%) minmax(0, 1fr) minmax(260px, 330px); }
  .layout.fm-closed { grid-template-columns: minmax(0, 1fr) minmax(260px, 330px); }
  .layout.fm-closed .fm { display: none; }
  @media (max-width: 1400px) { .layout { grid-template-columns: minmax(420px, 42%) minmax(0, 1fr); }
                               .layout > .side-right { grid-column: 1 / -1; display: grid; gap: 1rem;
                                 grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
                               .layout > .side-right > .card { margin: 0; }
                               .layout.fm-closed { grid-template-columns: 1fr; } }
  .layout > * { min-width: 0; }
  @media (max-width: 900px) { .layout, .layout.fm-closed { grid-template-columns: 1fr; }
                              .fm { position: static; height: 70vh; } }
  @media (max-width: 560px) { .fm-head, .fm-row { grid-template-columns: minmax(0, 1fr) 5rem 4rem; }
                              .fm-head button:nth-child(2), .fm-row .dt { display: none; } }
  .wrap { overflow-wrap: anywhere; }
  .btn.ghost { border-color: transparent; background: transparent; }
  .btn.ghost:hover, .btn.ghost.on { background: var(--panel-2); }
  .btn.danger { background: var(--crit); border-color: var(--crit); color: #fff; font-weight: 600; }
  .bad { color: var(--crit); }
  /* проводник */
  .fm { position: sticky; top: 1rem; display: flex; flex-direction: column; padding: .8rem .9rem;
        height: calc(100vh - 6rem); min-height: 420px; }
  .fm-top { display: flex; align-items: center; gap: .35rem; }
  .fm-nav { display: flex; align-items: center; gap: .25rem; margin: .5rem 0 .4rem; }
  .nav-btn { width: 30px; height: 30px; border: 0; border-radius: 6px; background: transparent; color: var(--text);
             font-size: 1.35rem; line-height: 1; cursor: pointer; flex: none; }
  .nav-btn:hover:not(:disabled) { background: var(--panel-2); } .nav-btn:disabled { opacity: .3; cursor: default; }
  .crumbs { flex: 1; min-width: 0; display: flex; align-items: center; gap: .1rem; overflow: hidden; cursor: text;
            padding: .2rem .3rem; border-radius: 6px; min-height: 32px; }
  .crumbs:hover { background: var(--panel-2); }
  .crumbs button { border: 0; background: transparent; color: var(--text); font: inherit; font-size: .88rem;
                   padding: .15rem .35rem; border-radius: 5px; cursor: pointer; white-space: nowrap; display: inline-flex; }
  .crumbs button::before { content: ""; width: 15px; height: 13px; margin-right: .3rem; align-self: center;
                           background: var(--folder); border-radius: 2px 3px 3px 3px; }
  .crumbs button:hover { background: var(--line); } .crumbs button.last { font-weight: 600; }
  .crumbs .sep { color: var(--muted); }
  .crumbs-edit { flex: 1; min-width: 0; font: .88rem "JetBrains Mono", ui-monospace, monospace !important;
                 padding: .35rem .5rem !important; }
  .fm-filter { margin-bottom: .4rem; padding: .35rem .6rem !important; font-size: .86rem !important; }
  .fm-table { flex: 1; min-height: 0; display: flex; flex-direction: column; border: 1px solid var(--line);
              border-radius: 8px; overflow: hidden; outline: none; }
  .fm-table:focus-visible { border-color: var(--accent); }
  .fm-head, .fm-row { display: grid; grid-template-columns: minmax(0, 1fr) 9.6rem 5.4rem 4.6rem; align-items: center; }
  .fm-head { background: var(--panel-2); border-bottom: 1px solid var(--line); }
  .fm-head button { border: 0; background: transparent; color: var(--muted); font: inherit; font-size: .76rem;
                    font-weight: 600; text-align: left; padding: .45rem .6rem; cursor: pointer;
                    border-left: 1px solid var(--line); white-space: nowrap; overflow: hidden; }
  .fm-head button:first-child { border-left: 0; padding-left: 2.2rem; }
  .fm-head button:hover { color: var(--text); } .fm-head i { font-style: normal; font-size: .65rem; margin-left: .2rem; }
  .fm-body { flex: 1; overflow-y: auto; overflow-x: hidden; padding-bottom: 2rem; }
  .fm-row { position: relative; padding-left: 2.2rem; min-height: 32px; font-size: .86rem; user-select: none; cursor: default; }
  .fm-row:hover { background: var(--panel-2); } .fm-row.sel { background: var(--accent-soft); }
  .fm-row .ic { position: absolute; left: .65rem; width: 18px; height: 18px; }
  .ic.dir path { fill: var(--folder); } .ic.link path { fill: var(--folder); }
  .ic.file path { fill: var(--file); } .ic.file .fold { fill: none; stroke: var(--panel); stroke-width: 1.2; }
  .fm-row span { padding: 0 .6rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fm-row .nm { padding-left: 0; }
  .fm-row .dt, .fm-row .sz, .fm-row .kd { color: var(--muted); font-size: .8rem; }
  .fm-empty { padding: 1rem; color: var(--muted); font-size: .86rem; }
  .fm-status { font-size: .8rem; color: var(--text); margin-top: .45rem; min-height: 1.2rem; overflow-wrap: anywhere; }
  /* меню и окна */
  .menu { position: fixed; z-index: 20; min-width: 230px; background: var(--panel); border: 1px solid var(--line);
          border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.35); padding: .3rem; }
  .menu button { display: flex; align-items: center; width: 100%; text-align: left; background: none; border: 0;
                 color: var(--text); font: inherit; font-size: .88rem; padding: .42rem .6rem; border-radius: 6px; cursor: pointer; }
  .menu button:hover:not(:disabled) { background: var(--panel-2); }
  .menu button:disabled { color: var(--muted); opacity: .55; cursor: default; }
  .menu button.accent { color: var(--accent); font-weight: 600; } .menu button.danger { color: var(--crit); }
  .menu .ck { width: 1.1rem; flex: none; color: var(--accent); } .menu .arr { margin-left: auto; color: var(--muted); }
  .menu hr { border: 0; border-top: 1px solid var(--line); margin: .25rem .3rem; }
  .modal { position: fixed; inset: 0; z-index: 30; background: rgba(0,0,0,.5); display: flex;
           align-items: center; justify-content: center; padding: 1rem; }
  .modal-box { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.2rem;
               width: min(460px, 100%); box-shadow: 0 20px 50px rgba(0,0,0,.4); }
  .modal-box.wide { width: min(1100px, 100%); max-height: 90vh; display: flex; flex-direction: column; }
  .modal-box h2 { margin-bottom: .5rem; }
  .modal-box pre.view { flex: 1; overflow: auto; max-height: 75vh; white-space: pre; }
  /* что проверить: модули с целями */
  .mod-grid { display: grid; gap: .9rem; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); margin-top: 1rem; }
  .mod { border: 1px solid var(--line); border-radius: 10px; padding: .7rem .75rem; background: var(--panel-2); min-width: 0; }
  .mod-head { display: flex; align-items: baseline; gap: .45rem; flex-wrap: wrap; margin-bottom: .45rem; }
  .mod-head h3 { margin: 0; font-size: .95rem; }
  .mod-head .count { font-size: .72rem; color: var(--muted); background: var(--panel); border-radius: 999px; padding: 0 .45rem; }
  .targets { display: flex; flex-direction: column; gap: .3rem; }
  .target { display: flex; flex-direction: column; align-items: flex-start; text-align: left; width: 100%;
            background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: .4rem .6rem;
            color: var(--text); font: inherit; cursor: pointer; }
  .target:hover { border-color: var(--accent); background: var(--accent-soft); }
  .t-title { font-weight: 600; font-size: .88rem; overflow-wrap: anywhere; }
  .t-sub { color: var(--muted); font-size: .76rem; overflow-wrap: anywhere; }
  .link-btn { border: 0; background: none; color: var(--accent); font: inherit; font-size: .82rem; padding: .35rem 0 0; cursor: pointer; }
  details.manual { margin-top: 1.1rem; border-top: 1px solid var(--line); padding-top: .8rem; }
  /* результат: строка фильтров, переключатель кода, группы кластера */
  .toolbar { margin-bottom: .2rem; }
  .search { max-width: 300px; padding: .4rem .7rem !important; font-size: .88rem !important; }
  .switch { display: inline-flex; align-items: center; gap: .45rem; font-size: .86rem; cursor: pointer; user-select: none; }
  .switch input { display: none; }
  .switch span { width: 34px; height: 20px; border-radius: 999px; background: var(--line); position: relative; transition: background .15s; }
  .switch span::after { content: ""; position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; border-radius: 50%;
                        background: var(--panel); transition: left .15s; }
  .switch input:checked + span { background: var(--accent); } .switch input:checked + span::after { left: 17px; }
  th .legend { display: block; text-transform: none; letter-spacing: 0; font-weight: 400; font-size: .74rem; margin-top: .15rem; }
  .legend .h-exists { color: var(--muted); font-family: "JetBrains Mono", ui-monospace, monospace; }
  .legend .h-new { color: var(--ok); font-family: "JetBrains Mono", ui-monospace, monospace; }
  .narrow-only { display: none; } p.legend { font-size: .78rem; color: var(--muted); margin: .3rem 0 0; }
  .sub-h { margin: 1.3rem 0 .4rem; font-size: 1rem; } .sub-h .muted { font-weight: 400; font-size: .84rem; }
  details.group { border: 1px solid var(--line); border-radius: 10px; margin-top: .5rem; padding: 0 .8rem; }
  details.group > summary { padding: .55rem 0; color: var(--text); font-size: .9rem; display: list-item; overflow-wrap: anywhere; }
  details.group > summary .pill { margin-left: .3rem; }
  details.group[open] > summary { border-bottom: 1px solid var(--line); }
  details.group .place:first-of-type { border-top: 0; }
  /* узкое окно: строка таблицы — карточка с подписями, ничего не сжимается в столбик по слову */
  @media (max-width: 1000px) {
    table.fixed, table.fixed tbody, table.fixed tr, table.fixed td { display: block; width: auto; }
    table.fixed thead, table.fixed colgroup { display: none; }
    table.fixed tr { padding: .6rem 0; border-bottom: 1px solid var(--line); }
    table.fixed td { border: 0; padding: .15rem .3rem; }
    table.fixed td.c-head { display: inline-block; vertical-align: middle; }
    table.fixed td.c-inline { display: inline-block; vertical-align: top; margin-right: 1.4rem; max-width: 100%; }
    table.fixed td[data-label]::before { content: attr(data-label); display: block; color: var(--muted);
      font: 600 .7rem/1.4 -apple-system, "Segoe UI", Roboto, sans-serif; text-transform: uppercase; letter-spacing: .04em; }
    .card { padding: .9rem; } details.group { padding: 0 .5rem; } .narrow-only { display: block; }
  }
</style>
</head>
<body>
<header class="top">
  <a class="logo" href="/">cast<span>.</span></a>
  <span class="ver">веб-интерфейс · v{{ version }}</span>
  {% if not login_page %}<nav><a href="/">Новая проверка</a>{% if auth_on %}<a href="/logout">Выйти</a>{% endif %}</nav>{% endif %}
</header>
<main{% if narrow %} class="narrow"{% endif %}>
{% block body %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
