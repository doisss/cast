{% extends "base.html.jinja" %}
{% macro sev_pill(f) %}<span class="pill sev-{{ f.severity.value }}">{{ f.severity.value | upper }}</span>{% endmacro %}

{% macro places_block(places) %}
{% for pl in places %}
<div class="place" data-place>
  <div class="place-head">
    <span class="mono">▌ {{ pl.label }}</span>
    <span class="small">{{ pl.rules | length }} шт.:</span>
    {% for sev in ["critical", "high", "medium", "low", "unknown"] if pl.counts[sev] %}
    <span class="pill sev-{{ sev }}">{{ sev | upper }} {{ pl.counts[sev] }}</span>
    {% endfor %}
  </div>
  {% if pl.code %}
  <details class="code-details"><summary>код в файле</summary>
    <pre class="term">{% for l in pl.code %}<span class="ln">{{ "%4s" | format(l.number) }}</span> <span class="mk">{{ l.mark }}</span> <span class="{{ '' if l.cause else 'dimmed' }}">{{ l.content }}</span>
{% endfor %}</pre></details>
  {% elif pl.no_code %}<p class="muted small">Trivy не прислал строки кода для этого места.</p>{% endif %}
  {% set has_hint = pl.rules | selectattr("hint") | list | length > 0 %}
  {% if has_hint %}<p class="legend narrow-only"><span class="h-exists">серым</span> — менять не нужно,
    <span class="h-new">зелёным</span> — добавить или изменить</p>{% endif %}
  <div class="table-wrap"><table class="fixed">
    <colgroup><col style="width:6.5rem"><col style="width:6.5rem"><col><col style="width:44%"></colgroup>
    <thead><tr><th>Уровень</th><th>ID</th><th>Что не так</th>
      <th>Как исправить{% if has_hint %}<span class="legend"><span class="h-exists">серым</span> — менять не нужно,
        <span class="h-new">зелёным</span> — добавить или изменить</span>{% endif %}</th></tr></thead>
    <tbody>
    {% for r in pl.rules %}{% set f = r.f %}
      <tr data-row data-key="{{ f.severity.value }}"
          data-search="{{ (f.check_id ~ ' ' ~ f.title ~ ' ' ~ (f.location or '')) | lower }}">
        <td class="c-head">{{ sev_pill(f) }}</td>
        <td class="mono c-head">{{ f.check_id }}</td>
        <td data-label="Что не так">{{ f.title }}
          {% if r.message %}<div class="sub-line">{{ r.message }}</div>{% endif %}
          {% if f.url %}<div><a class="small" href="{{ f.url }}" target="_blank" rel="noopener">{{ f.url }}</a></div>{% endif %}
        </td>
        <td class="small" data-label="Как исправить">{{ f.remediation or "—" }}
          {% if r.hint %}<pre class="hint">{% for h in r.hint %}<span class="{{ 'h-exists' if h.state == 'exists' else 'h-new' }}">{{ h.text }}</span>
{% endfor %}</pre>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
</div>
{% endfor %}
{% endmacro %}

{% macro vuln_table(rows, show_where) %}
{% set fs = rows | map(attribute="f") | list %}
{% set has_pkg = fs | selectattr("package") | list | length > 0 %}
{% set has_ver = fs | selectattr("installed_version") | list | length > 0 %}
{% set has_loc = show_where and fs | selectattr("location") | list | length > 0 %}
<div class="table-wrap vuln-wrap" style="margin-top:.6rem"><table class="fixed vuln{{ ' with-where' if has_loc }}">
  <colgroup><col style="width:6.5rem"><col style="width:9.5rem">
    {% if has_pkg %}<col style="width:15%">{% endif %}
    {% if has_ver %}<col style="width:11.5rem"><col style="width:11.5rem">{% endif %}
    <col>{% if has_loc %}<col style="width:16%">{% endif %}</colgroup>
  <thead><tr><th>Уровень</th><th>ID</th>
    {% if has_pkg %}<th>Пакет</th>{% endif %}
    {% if has_ver %}<th>Установлена</th><th>Исправлено в</th>{% endif %}
    <th>Название</th>
    {% if has_loc %}<th>Где</th>{% endif %}</tr></thead>
  <tbody>
  {% for r in rows %}{% set f = r.f %}
    <tr data-row data-key="{{ f.severity.value }}"
        data-search="{{ (f.check_id ~ ' ' ~ f.title ~ ' ' ~ (r.packages | join(' ')) ~ ' ' ~ (f.location or '')) | lower }}">
      <td class="c-head">{{ sev_pill(f) }}</td>
      <td class="mono c-head">{% if f.url %}<a href="{{ f.url }}" target="_blank" rel="noopener">{{ f.check_id }}</a>{% else %}{{ f.check_id }}{% endif %}</td>
      {% if has_pkg and has_ver and r.by_version | length > 1 %}
      {# у пакетов разные версии: пакеты по версии, версия напротив своих пакетов #}
      <td colspan="2" class="mono c-inline" data-label="Пакеты и версии"><div class="pv">
        {% for v, names in r.by_version %}<div>{% for pk in names %}<div>{{ pk }}</div>{% endfor %}</div><div class="small">{{ v }}</div>{% endfor %}
      </div></td>
      {% else %}
      {% if has_pkg %}<td class="mono c-inline" data-label="Пакет">{% for pk in r.packages %}<div>{{ pk }}</div>{% else %}—{% endfor %}</td>{% endif %}
      {% if has_ver %}<td class="mono small c-inline" data-label="Установлена">{{ f.installed_version or "—" }}</td>{% endif %}
      {% endif %}
      {% if has_ver %}
      <td class="mono small c-inline" style="color:var(--ok)" data-label="Исправлено в">{{ f.fixed_version or "" }}{% if not f.fixed_version %}<span class="muted">исправления нет</span>{% endif %}</td>
      {% endif %}
      <td data-label="Название">{{ f.title }}
        {% if f.remediation %}<div class="fix">Как исправить: {{ f.remediation }}</div>{% endif %}
      </td>
      {% if has_loc %}<td class="mono small" data-label="Где">{{ f.location or "—" }}</td>{% endif %}
    </tr>
  {% endfor %}
  </tbody>
</table></div>
{% endmacro %}

{% block title %}cast — {{ job.query }}{% endblock %}
{% block body %}
<div class="row" style="margin-bottom:1rem">
  <div>
    {% set label = job.target.label if job.target else job.query %}
    <h1>{{ label }}</h1>
    <div class="muted small">
      {# без повторов: вид цели — если его нет в заголовке, команда — если она не то же, что заголовок #}
      проверка #{{ job.id }}
      {%- if job.target %}{% set kind = kind_titles.get(job.target.kind, job.target.kind) %}
        {%- if kind | lower not in label | lower %} · {{ kind }}{% if job.target.subtype %} ({{ job.target.subtype }}){% endif %}{% endif %}{% endif %}
      {%- if job.query not in label or job.engines %} · <code>cast scan {{ job.query }}{% if job.engines %} -e {{ job.engines | join(",") }}{% endif %}</code>{% endif %}
    </div>
  </div>
  <span class="spacer"></span>
  {% if result %}
  <span class="row" style="flex-wrap:nowrap">
    <a class="btn" href="/jobs/{{ job.id }}/report.html">↓ HTML</a>
    <a class="btn" href="/jobs/{{ job.id }}/report.json">↓ JSON</a>
  </span>
  {% endif %}
</div>

{% if job.state in ("queued", "running") %}
<div class="card" id="live">
  <div class="row"><span class="dot run"></span><strong id="live-engine">{{ job.engine or "в очереди" }}</strong>
    <span class="muted" id="live-text">{{ job.text }}</span><span class="spacer"></span>
    <span class="muted small mono" id="live-time"></span></div>
  <div class="bar indet" id="live-bar" style="margin-top:.8rem"><div></div></div>
  <div class="muted small" id="live-label" style="margin-top:.3rem"></div>
  <div class="log mono" id="live-log" hidden></div>
</div>
{% elif job.state == "error" %}
<div class="banner bad">Ошибка: {{ job.error }}</div>
<a class="btn" href="/">Новая проверка</a>
{% endif %}

{% if result %}
<div class="card">
  {% for r in result.runs %}
  <div class="row small">
    <span class="dot {{ 'on' if r.status == 'ok' else 'off' }}"></span>
    <strong>{{ r.name }}</strong>
    {% if r.status == "ok" %}<span class="muted">готово за {{ "%.1f" | format(r.seconds) }} с, записей: {{ r.findings }}</span>
    {% else %}<span style="color:var(--crit)">НЕ ВЫПОЛНЕН: {{ r.detail }}</span>{% endif %}
  </div>
  {% endfor %}
</div>

{% if result.image_scan_failed %}
<div class="banner bad">Проверка НЕ выполнена: главный движок для этой цели не отработал. Это не значит, что всё в порядке.</div>
{% if need_root %}<div class="banner note">Docker Bench проверяет Docker от root. Запустите веб так: <code>sudo cast web</code>
  (пароль для входа тот же).</div>{% endif %}
<a class="btn" href="/">Новая проверка</a>
{% endif %}

{% for item in sections %}{% set sec = item.sec %}
<div class="card" data-section>
  <div class="section-head">
    <h2>{{ item.title }}</h2>
    <span class="muted small">{{ [item.tool, sec.extra] | select | join(", ") }}</span>
  </div>

  {% if sec.kind == "status" %}
    <div class="row">
      {% for st in ["WARN", "NOTE", "INFO", "PASS"] %}
      <span class="chip" data-filter="{{ st }}" title="{{ status_help[st] }}">
        <span class="pill st-{{ st }}">{{ st }}</span> {{ item.counts[st] }}</span>
      {% endfor %}
      {% if "score" in sec.summary %}<span class="spacer"></span><strong>Score: {{ sec.summary.score }}</strong>{% endif %}
    </div>
    {% if "score" in sec.summary %}
    <p class="muted small" style="margin:.5rem 0 0">Score считает Docker Bench: +1 за каждый зачётный PASS
      ({{ sec.summary.score + item.counts.WARN }}), −1 за каждый WARN ({{ item.counts.WARN }}).
      INFO и NOTE не влияют, и не все PASS зачётные.</p>
    {% endif %}
    {% if not sec.findings %}<p>Docker Bench не вернул ни одной проверки.</p>{% endif %}
    {% set has_fix = sec.findings | selectattr("remediation") | list | length > 0 %}
    {% for g in item.groups %}
      <div class="group-title">{{ g.key ~ ". " if g.key }}{{ g.ru }} <span class="muted">{{ g.en }}</span>
        <span class="spacer"></span>
        <span class="small muted" style="font-weight:400">{% for st in ["WARN","NOTE","INFO","PASS"] if g.counts[st] %}{{ st }} {{ g.counts[st] }}{{ " · " if not loop.last }}{% endfor %}</span>
      </div>
      <div class="table-wrap"><table>
        <thead><tr><th style="width:5.5rem">Статус</th><th>Проверка</th>{% if has_fix %}<th style="width:38%">Что сделать</th>{% endif %}</tr></thead>
        <tbody>
        {% for f in g.findings %}
          <tr data-row data-key="{{ f.status }}" class="{{ 'is-pass' if f.status == 'PASS' }}"
              data-search="{{ (f.check_id ~ ' ' ~ f.title ~ ' ' ~ (f.details | join(' '))) | lower }}">
            <td><span class="pill st-{{ f.status }}">{{ f.status }}</span></td>
            <td>
              {% if f.check_id != "—" %}<strong class="mono">{{ f.check_id }}</strong> {% endif %}{{ f.title }}
              {% for m in marks(f) %}<span class="muted small"> ({{ m }})</span>{% endfor %}
              {% if f.details %}<ul class="details">{% for d in f.details %}<li>{{ d }}</li>{% endfor %}</ul>{% endif %}
            </td>
            {% if has_fix %}<td class="small">
              {% if f.status != "PASS" %}{{ f.remediation or "" }}
              {% if f.remediation_impact %}<div class="sub-line">Чем грозит: {{ f.remediation_impact }}</div>{% endif %}{% endif %}
            </td>{% endif %}
          </tr>
        {% endfor %}
        </tbody>
      </table></div>
    {% endfor %}

  {% else %}
    <div class="row toolbar">
      {% for sev in ["critical", "high", "medium", "low", "unknown"] if item.counts[sev] %}
      <span class="chip" data-filter="{{ sev }}"><span class="pill sev-{{ sev }}">{{ sev | upper }}</span> {{ item.counts[sev] }}</span>
      {% endfor %}
      <span class="spacer"></span>
      {% if item.places or item.resources or item.files %}
      <label class="switch" title="Открыть или закрыть код во всех местах сразу"><input type="checkbox" data-code-all><span></span> Код из файла</label>
      {% endif %}
      {% if sec.findings %}<input type="text" data-search-input placeholder="Поиск: CVE, пакет, ресурс, файл" class="search">{% endif %}
    </div>
    {% if sec.findings and item.places %}
      {{ places_block(item.places) }}
      <p class="muted small hidden" data-empty>Под фильтр ничего не подходит.</p>
    {% elif sec.findings and item.resources is defined %}
      {% if item.resources %}
      <h3 class="sub-h">Ошибки конфигурации ресурсов <span class="muted">{{ item.resources | sum(attribute="total") }} шт., ресурсов: {{ item.resources | length }}</span></h3>
      {% for g in item.resources %}
      <details class="group" data-group{% if loop.first %} open{% endif %}>
        <summary><span class="mono">{{ g.name }}</span> <span class="small muted">{{ g.total }} шт.</span>
          {% for sev in ["critical", "high", "medium", "low", "unknown"] if g.counts[sev] %}<span class="pill sev-{{ sev }}">{{ sev | upper }} {{ g.counts[sev] }}</span>{% endfor %}</summary>
        {{ places_block(g.places) }}
      </details>
      {% endfor %}
      {% endif %}
      {% if item.vulns %}
      <h3 class="sub-h">Уязвимости в образах <span class="muted">{{ item.vulns | sum(attribute="total") }} шт., ресурсов: {{ item.vulns | length }}</span></h3>
      {% for g in item.vulns %}
      <details class="group" data-group{% if loop.first and not item.resources %} open{% endif %}>
        <summary><span class="mono">{{ g.name }}</span> <span class="small muted">{{ g.total }} шт.</span>
          {% for sev in ["critical", "high", "medium", "low", "unknown"] if g.counts[sev] %}<span class="pill sev-{{ sev }}">{{ sev | upper }} {{ g.counts[sev] }}</span>{% endfor %}</summary>
        {% for t in g.targets %}
        <div class="place" data-place>
          <div class="place-head"><span class="mono">▌ {{ t.name }}</span> <span class="small muted" style="font-weight:400">{{ t.what }}</span>
            <span class="small">{{ t.total }} шт.:</span>
            {% for sev in ["critical", "high", "medium", "low", "unknown"] if t.counts[sev] %}<span class="pill sev-{{ sev }}">{{ sev | upper }} {{ t.counts[sev] }}</span>{% endfor %}</div>
          {{ vuln_table(t.rows, false) }}
        </div>
        {% endfor %}
      </details>
      {% endfor %}
      {% endif %}
      <p class="muted small hidden" data-empty>Под фильтр ничего не подходит.</p>
    {% elif sec.findings and item.files %}
      {% if item.rows %}
      <h3 class="sub-h">{{ item.vulns_title }} <span class="muted">{{ item.vulns_total }} шт.</span></h3>
      {{ vuln_table(item.rows, item.show_where) }}
      {% endif %}
      <h3 class="sub-h">Ошибки конфигурации в файлах <span class="muted">{{ item.files | sum(attribute="total") }} шт., файлов: {{ item.files | length }}</span></h3>
      {% for g in item.files %}
      <details class="group" data-group open>
        <summary><span class="mono">{{ g.name }}</span> <span class="small muted">{{ g.total }} шт.</span>
          {% for sev in ["critical", "high", "medium", "low", "unknown"] if g.counts[sev] %}<span class="pill sev-{{ sev }}">{{ sev | upper }} {{ g.counts[sev] }}</span>{% endfor %}</summary>
        {{ places_block(g.places) }}
      </details>
      {% endfor %}
      <p class="muted small hidden" data-empty>Под фильтр ничего не подходит.</p>
    {% elif sec.findings %}
      {{ vuln_table(item.rows, item.show_where) }}
      <p class="muted small hidden" data-empty>Под фильтр ничего не подходит.</p>
    {% elif sec.note %}<p>{{ sec.note }}</p>
    {% else %}<p class="banner" style="background:var(--ok-soft);color:var(--ok)">Проблем не найдено.</p>{% endif %}
  {% endif %}
</div>
{% endfor %}

{% if note %}<div class="banner note">{{ note }}</div>{% endif %}
{% endif %}
{% endblock %}

{% block scripts %}
<script>
{% if job.state in ("queued", "running") %}
  (function poll() {
    fetch("/jobs/{{ job.id }}/status").then(r => r.json()).then(s => {
      if (s.state === "done" || s.state === "error") { location.reload(); return; }
      document.getElementById("live-engine").textContent = s.engine || "в очереди";
      document.getElementById("live-text").textContent = s.text || "";
      document.getElementById("live-time").textContent = s.seconds ? s.seconds.toFixed(0) + " с" : "";
      const bar = document.getElementById("live-bar");
      if (s.fraction === null) { bar.classList.add("indet"); bar.firstElementChild.style.width = ""; }
      else { bar.classList.remove("indet"); bar.firstElementChild.style.width = (s.fraction * 100) + "%"; }
      document.getElementById("live-label").textContent = s.label || "";
      const log = document.getElementById("live-log");
      log.textContent = s.log.join("\n");
      log.hidden = !s.log.length;
      log.style.whiteSpace = "pre-wrap";
      log.scrollTop = log.scrollHeight;
      setTimeout(poll, 800);
    }).catch(() => setTimeout(poll, 2000));
  })();
{% endif %}
  // фильтр по уровню/статусу и поиск — внутри каждого раздела отдельно
  document.querySelectorAll("[data-section]").forEach(sec => {
    const off = new Set();
    const search = sec.querySelector("[data-search-input]");
    const apply = () => {
      const q = search ? search.value.trim().toLowerCase() : "";
      let shown = 0;
      sec.querySelectorAll("[data-row]").forEach(row => {
        const ok = !off.has(row.dataset.key) && (!q || row.dataset.search.includes(q));
        row.classList.toggle("hidden", !ok); if (ok) shown++;
      });
      // место в файле, ресурс или образ без подходящих строк — прячем целиком
      sec.querySelectorAll("[data-place], [data-group]").forEach(box => {
        const any = box.querySelector("[data-row]:not(.hidden)");
        box.classList.toggle("hidden", !any);
        if (q && any && box.matches("[data-group]")) box.open = true;
      });
      const empty = sec.querySelector("[data-empty]");
      if (empty) empty.classList.toggle("hidden", shown > 0);
    };
    sec.querySelectorAll("[data-filter]").forEach(chip => chip.addEventListener("click", () => {
      const k = chip.dataset.filter;
      off.has(k) ? off.delete(k) : off.add(k);
      chip.classList.toggle("off", off.has(k)); apply();
    }));
    if (search) search.addEventListener("input", apply);
    const all = sec.querySelector("[data-code-all]");
    if (all) all.addEventListener("change", () =>
      sec.querySelectorAll("details.code-details").forEach(d => d.open = all.checked));
  });
</script>
{% endblock %}
