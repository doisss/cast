{% extends "base.html.jinja" %}
{% block title %}cast — вход{% endblock %}
{% block body %}
<div class="card login">
  <h1>Вход</h1>
  <p class="muted">Логин и пароль задаются при первом запуске <code>cast web</code> в терминале.
    Забыли пароль — <code>cast web --reset-password</code>.</p>
  {% if error %}<p class="login-error">{{ error }}</p>{% endif %}
  <form method="post" action="/login">
    <input type="hidden" name="token" value="{{ token }}">
    <label>Логин<input type="text" name="login" value="{{ login }}" autocomplete="username" {% if not login %}autofocus {% endif %}required></label>
    <label>Пароль<input type="password" name="password" autocomplete="current-password" {% if login %}autofocus {% endif %}required></label>
    <button class="btn primary" type="submit">Войти</button>
  </form>
</div>
{% endblock %}
